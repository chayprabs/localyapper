{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LocalYapper",
  "version": "1.0.0",
  "identifier": "com.localyapper.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/*": "resources/",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "dmg": {}
    },
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "publisher": "LocalYapper contributors",
    "copyright": "MIT License",
    "category": "Productivity",
    "shortDescription": "Offline voice dictation",
    "longDescription": "Press a key, speak, let go: your words appear in the focused app. Speech recognition runs on this computer; audio never leaves it.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libasound2",
          "libxdo3"
        ],
        "recommends": [
          "wl-clipboard",
          "wtype"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "alsa-lib",
          "libxdo"
        ],
        "recommends": [
          "wl-clipboard",
          "wtype"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self'; img-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "LocalYapper",
        "width": 900,
        "height": 650,
        "minWidth": 560,
        "minHeight": 480,
        "resizable": true,
        "center": true,
        "decorations": false,
        "visible": false,
        "url": "/"
      }
    ],
    "macOSPrivateApi": true
  }
}
